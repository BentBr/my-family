{
    "name": "my-fam-tree-fe",
    "private": true,
    "version": "0.1.21",
    "type": "module",
    "scripts": {
        "dev": "vite --port 5173",
        "generate:images": "node scripts/generate-images.js",
        "generate:sitemap": "node scripts/generate-sitemap.js",
        "build": "pnpm run generate:images && vue-tsc --noEmit && vite-ssg build && pnpm run generate:sitemap",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "vue-tsc --noEmit",
        "openapi-codegen": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts",
        "test": "vue-tsc --noEmit && vitest run",
        "test:e2e": "playwright test -c e2e/playwright.config.ts",
        "knip": "knip",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@lucide/vue": "^1.24.0",
        "@tanstack/vue-query": "^5.101.2",
        "@unhead/vue": "^3.1.8",
        "d3-ease": "^3.0.1",
        "d3-selection": "^3.0.0",
        "d3-transition": "^3.0.1",
        "d3-zoom": "^3.0.0",
        "openapi-fetch": "^0.17.0",
        "pinia": "^4.0.2",
        "vue": "^3.5.39",
        "vue-i18n": "^11.4.6",
        "vue-router": "^5.2.0",
        "vuetify": "^4.1.5"
    },
    "devDependencies": {
        "@playwright/experimental-ct-vue": "^1.61.1",
        "@playwright/test": "^1.61.1",
        "@types/d3-ease": "^3.0.2",
        "@types/d3-selection": "^3.0.10",
        "@types/d3-transition": "^3.0.9",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/eslint-config-prettier": "^10.0.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "happy-dom": "^20.10.6",
        "knip": "^6.27.0",
        "openapi-typescript": "^7.4.0",
        "pg": "^8.22.0",
        "prettier": "^3.9.5",
        "sass-embedded": "^1.100.0",
        "sharp": "^0.35.3",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "vite-plugin-vuetify": "^2.0.4",
        "vite-ssg": "^28.3.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.7"
    },
    "packageManager": "pnpm@10.33.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp"
        ]
    }
}
